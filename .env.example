# ==============================================================================
# GimnasioAccess — Variables de Entorno de Configuración
# Copia este archivo a .env y completa los valores correspondientes
# ==============================================================================

# URL base del proyecto Supabase (Dashboard -> Settings -> API)
VITE_SUPABASE_URL=https://tu-proyecto.supabase.co

# Clave pública anónima de Supabase (Dashboard -> Settings -> API)
VITE_SUPABASE_ANON_KEY=tu-anon-key-aqui

# Identificador UUID de la sucursal / área del gimnasio asignada a este dispositivo
# Por defecto se utiliza el UUID semilla de la recepción principal:
VITE_KIOSK_LAB_ID=11111111-1111-1111-1111-111111111111

# Modo de depuración y desarrollo:
# 'true' habilita botones de acceso rápido con cuentas demo en /login y simulador API.
# 'false' para entornos de producción (oculta cuentas demo y credenciales visibles).
VITE_DEBUG_MODE=true

# Nombre de la sucursal o gimnasio para el encabezado
VITE_GYM_NAME=Gimnasio Principal
